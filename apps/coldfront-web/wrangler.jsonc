{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "coldfront",
  "compatibility_date": "2026-11-17",
  // Keep legacy registry until @cloudflare/vite-plugin stops asserting on node:process
  // under the default new_module_registry (workers-sdk#16381).
  "compatibility_flags": ["legacy_module_registry"],
  "main": "./worker/index.ts",
  "upload_source_maps": true,
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
